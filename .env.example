# Copy to .env and fill in. Secrets are read ONLY from environment variables (CF-3).
# Never commit .env.

# Anthropic API (provider kind: anthropic)
ANTHROPIC_API_KEY=replace-me

# OpenRouter (provider kind: openai_compat)
OPENROUTER_API_KEY=replace-me

# LM Studio usually needs no key; set one only if your server requires it.
LMSTUDIO_API_KEY=
